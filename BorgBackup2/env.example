# Copy this to .env, fill in real values, then:
#   chmod 600 .env
# and make sure .env + repo.key are in .gitignore / .dockerignore.

# Local path to the repo, as seen INSIDE the container. Must match the
# /repo volume mount in docker-compose.yml.
BORG_REPO=/repo

# Passphrase that unlocks repo.key (NOT the key file itself).
BORG_PASSPHRASE=change-me

# Optional overrides
ARCHIVE_NAME_PREFIX=myhost
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
